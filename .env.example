# Supabase browser-safe project configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only PayFast credentials. Never prefix these with NEXT_PUBLIC_.
PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
PAYFAST_PASSPHRASE=your-payfast-passphrase
PAYFAST_SANDBOX=true
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional email of the sole administrator; still enforce authorization with Supabase RLS/server checks.
ADMIN_EMAIL=admin@example.com
