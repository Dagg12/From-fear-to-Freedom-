# Supabase browser-safe project configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only key used by trusted order creation and PayFast notifications.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-only PayFast credentials. Never prefix these with NEXT_PUBLIC_.
PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
PAYFAST_PASSPHRASE=your-payfast-passphrase
PAYFAST_SANDBOX=true
NEXT_PUBLIC_SITE_URL=https://your-domain.example
BOOK_SHIPPING_ZAR=

# Optional local pickup location shown in order notifications
BOOK_PICKUP_LOCATION=Pickup details to be confirmed

# Email alerts for new orders (Resend account and verified sender required)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Orders <orders@your-verified-domain.example>
ADMIN_ORDER_NOTIFICATION_EMAIL=your-admin-email@example.com
